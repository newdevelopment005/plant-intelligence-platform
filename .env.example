# =============================================
# Plant Intelligence Platform - Environment Variables
# =============================================
# Copy this file to .env and fill in the values

# =============================================
# GENERAL
# =============================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# =============================================
# API SERVICE
# =============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
CORS_ORIGINS=["http://localhost:3000"]

# =============================================
# DATABASE - PostgreSQL
# =============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=pip
POSTGRES_PASSWORD=password
POSTGRES_DB=pip
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# =============================================
# DATABASE - Neo4j
# =============================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password

# =============================================
# DATABASE - Qdrant
# =============================================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# =============================================
# REDIS
# =============================================
REDIS_URL=redis://redis:6379/0

# =============================================
# AUTHENTICATION
# =============================================
JWT_SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================
# AI SERVICE
# =============================================
AI_SERVICE_URL=http://ai-service:8001
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MINI_MODEL=gpt-4o-mini
HF_TOKEN=hf-your-huggingface-token
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================
# FILE STORAGE
# =============================================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# =============================================
# EMAIL
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pip-platform.org

# =============================================
# EXTERNAL APIs
# =============================================
PUBMED_API_KEY=
NCBI_API_KEY=
UNIPROT_API_URL=https://rest.uniprot.org
