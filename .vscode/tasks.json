{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install All Dependencies",
      "type": "shell",
      "command": "make",
      "args": ["install"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start All Services",
      "type": "shell",
      "command": "make",
      "args": ["dev"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Stop All Services",
      "type": "shell",
      "command": "make",
      "args": ["stop"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": "make",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Lint All Code",
      "type": "shell",
      "command": "make",
      "args": ["lint"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Format All Code",
      "type": "shell",
      "command": "make",
      "args": ["format"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "API: Run Tests",
      "type": "shell",
      "command": "pytest",
      "args": ["tests/", "-v", "--tb=short"],
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "AI Service: Run Tests",
      "type": "shell",
      "command": "pytest",
      "args": ["tests/", "-v", "--tb=short"],
      "options": { "cwd": "${workspaceFolder}/apps/ai-service" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Web: Run Tests",
      "type": "shell",
      "command": "npm",
      "args": ["test"],
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "API: Start Dev Server",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AI Service: Start Dev Server",
      "type": "shell",
      "command": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8001",
      "options": { "cwd": "${workspaceFolder}/apps/ai-service" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Web: Start Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Docker: Start All Services",
      "type": "shell",
      "command": "docker-compose",
      "args": ["up", "-d"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Docker: Stop All Services",
      "type": "shell",
      "command": "docker-compose",
      "args": ["down"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Database: Run Migrations",
      "type": "shell",
      "command": "make",
      "args": ["migrate"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Database: Seed",
      "type": "shell",
      "command": "make",
      "args": ["seed"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Health Check All Services",
      "type": "shell",
      "command": "make",
      "args": ["health-check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
